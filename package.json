{
  "name": "workbench",
  "productName": "Workbench",
  "version": "1.0.0",
  "description": "个人工作台 - 一款用于任务管理、日程安排、习惯打卡、笔记记录与数据统计的 Windows 桌面应用",
  "main": "./out/main/index.js",
  "author": "Workbench Team",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "vitest run",
    "test:watch": "vitest",
    "dist": "electron-vite build && electron-builder --win --config electron-builder.yml"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "lunar-javascript": "^1.7.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/test-utils": "^2.5.1",
    "chardet": "^2.2.0",
    "dompurify": "^3.4.16",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "epubjs": "^0.3.93",
    "fflate": "^0.8.3",
    "js-untar": "^2.0.0",
    "jsdom": "^30.1.2",
    "jszip": "^3.10.2",
    "mammoth": "^1.13.0",
    "marked": "^18.1.0",
    "mhtml2html": "^3.0.0",
    "pdfjs-dist": "^6.4.299",
    "pinia": "^4.0.3",
    "rangy": "^1.3.0",
    "typescript": "^5.9.3",
    "underscore": "^1.13.8",
    "vite": "^7.3.7",
    "vitest": "^5.0.3",
    "vue": "^3.5.43",
    "vue-router": "^5.4.0",
    "vue-tsc": "^3.3.12"
  }
}
